EXPO_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
EXPO_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
EXPO_PUBLIC_APNS_ENV=sandbox

# Android local APK release publishing. Copy this file to .env.local or
# .env.production and fill these before running `pnpm release:android:local`.
INFCHAT_DOWNLOADS_BUCKET=infchat-downloads
INFCHAT_DOWNLOADS_PUBLIC_BASE_URL=https://downloads.example.com
INFCHAT_DOWNLOADS_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
INFCHAT_DOWNLOADS_S3_REGION=auto
INFCHAT_DOWNLOADS_S3_ACCESS_KEY_ID=replace-me
INFCHAT_DOWNLOADS_S3_SECRET_ACCESS_KEY=replace-me
INFCHAT_DOWNLOADS_S3_FORCE_PATH_STYLE=true

# Android release signing for local APK builds.
INFCHAT_ANDROID_RELEASE_KEYSTORE_PATH=/absolute/path/to/release.keystore
INFCHAT_ANDROID_RELEASE_KEYSTORE_PASSWORD=replace-me
INFCHAT_ANDROID_RELEASE_KEY_ALIAS=replace-me
INFCHAT_ANDROID_RELEASE_KEY_PASSWORD=replace-me
