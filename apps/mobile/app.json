{
  "expo": {
    "name": "InfChat",
    "slug": "infchat",
    "version": "0.0.1",
    "orientation": "portrait",
    "backgroundColor": "#080b12",
    "icon": "./assets/icon.png",
    "scheme": "infchat",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "backgroundColor": "#080b12",
      "bundleIdentifier": "app.infchat",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "InfChat uses the camera for video calls and media messages.",
        "NSMicrophoneUsageDescription": "InfChat uses the microphone for voice and video calls."
      },
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "app.infchat",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "pocketbaseUrl": "http://127.0.0.1:8090",
      "livekitUrl": "ws://127.0.0.1:7880",
      "downloadsBaseUrl": ""
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "./plugins/with-android-picture-in-picture",
      "./plugins/with-ios-call-notifications",
      "./plugins/with-ios-source-built-react-native",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          },
          "ios": {
            "enableMultitaskingCameraAccess": true
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "InfChat needs photo library access to send photos and videos.",
          "cameraPermission": "InfChat uses the camera for video calls and media messages.",
          "microphonePermission": "InfChat uses the microphone for voice and video calls."
        }
      ],
      "expo-document-picker",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
