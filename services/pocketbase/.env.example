POCKETBASE_URL=http://127.0.0.1:8090
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret

# Object storage for chat attachments: images, videos, files, and voice messages.
INFCHAT_MEDIA_STORAGE_PROFILE_ID=local-minio
INFCHAT_MEDIA_STORAGE_DRIVER=s3
INFCHAT_MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
INFCHAT_MEDIA_S3_PRESIGN_ENDPOINT=http://127.0.0.1:9000
INFCHAT_MEDIA_S3_REGION=us-east-1
INFCHAT_MEDIA_S3_BUCKET=infchat-media-dev
INFCHAT_MEDIA_S3_FORCE_PATH_STYLE=true
INFCHAT_MEDIA_S3_ACCESS_KEY_ID=infchat-dev
INFCHAT_MEDIA_S3_SECRET_ACCESS_KEY=infchat-dev-secret
INFCHAT_MEDIA_S3_SESSION_TOKEN=
INFCHAT_MEDIA_PUBLIC_BASE_URL=
INFCHAT_MEDIA_PRESIGN_TTL_SECONDS=900
INFCHAT_MEDIA_MULTIPART_THRESHOLD_BYTES=8388608
INFCHAT_MEDIA_MULTIPART_PART_SIZE_BYTES=8388608
INFCHAT_MEDIA_MAX_OBJECT_SIZE_BYTES=1073741824
INFCHAT_MEDIA_S3_SUPPORTS_LIST_PARTS=true
INFCHAT_MEDIA_S3_SUPPORTS_MULTIPART=true

APNS_ENV=sandbox #or production
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_BUNDLE_ID=app.infchat
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_APNS_P8_KEY\n-----END PRIVATE KEY-----"
APNS_PRIVATE_KEY_BASE64=
